# CDT Staff Hackathon — shared ignore rules
# These patterns apply inside every attendee's folder.

# --- Secrets & credentials (never commit these) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*

# --- JavaScript / Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# --- Website build output & caches ---
dist/
build/
out/
.next/
.nuxt/
.astro/
.svelte-kit/
.vercel/
.netlify/
.parcel-cache/
.cache/
_site/
.jekyll-cache/
.sass-cache/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors & local dev environments ---
.devcontainer/
.vscode/
.idea/
*.swp
*.swo
*~

# --- Logs & temp files ---
*.log
*.tmp
coverage/
